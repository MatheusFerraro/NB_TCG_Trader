# Copy to .env to override local dev defaults: `cp .env.example .env`.
# .env is gitignored. docker-compose falls back to these same values when no
# .env is present, so `docker compose up` works without this file.
#
# NOTE: local-dev-only Postgres credentials. Deployed environments use Supabase
# (CLAUDE.md §4/§13). Real secrets (Jwt__SigningKey, CardApi__Key, etc.) arrive
# with the auth/catalog work in #5 and will be added here then.

POSTGRES_USER=nbtcg
POSTGRES_PASSWORD=nbtcg_dev_password
POSTGRES_DB=nbtcg

# CORS allowed origins (one indexed entry per origin). Empty by default so the
# API is locked down until configured; set the deployed frontend origin(s) here.
# Dev uses http://localhost:5173 (see appsettings.Development.json).
# Cors__AllowedOrigins__0=https://your-frontend.example.com
