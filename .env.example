# Copy to .env to override local dev defaults: `cp .env.example .env`.
# .env is gitignored. docker-compose falls back to these same values when no
# .env is present, so `docker compose up` works without this file.
#
# NOTE: local-dev-only Postgres credentials. Deployed environments use Supabase
# (CLAUDE.md §4/§13). Real secrets (Jwt__SigningKey, CardApi__Key, etc.) are
# never committed — set them via user-secrets or your environment.

POSTGRES_USER=nbtcg
POSTGRES_PASSWORD=nbtcg_dev_password
POSTGRES_DB=nbtcg

# JWT signing (CLAUDE.md §15). The signing key is a SECRET: never commit a real
# value. It must be at least 256 bits (32 bytes). Generate one, e.g.:
#   openssl rand -base64 48
# Issuer/Audience/lifetimes have non-secret defaults in appsettings.json; override
# per environment as needed. Locally, prefer user-secrets:
#   dotnet user-secrets set "Jwt:SigningKey" "<generated-key>"
# Jwt__SigningKey=replace-with-a-32-byte-minimum-secret-key
# Jwt__Issuer=nb-tcg-trader
# Jwt__Audience=nb-tcg-trader

# API connection string. In docker-compose this is composed from the values above
# and points at the `db` service. For running the API outside compose (e.g. dotnet
# run against a local Postgres), set it here or via user-secrets — never commit a
# real one. The design-time EF factory falls back to these same local dev values.
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=nbtcg;Username=nbtcg;Password=nbtcg_dev_password

# CORS allowed origins (one indexed entry per origin). Empty by default so the
# API is locked down until configured; set the deployed frontend origin(s) here.
# Dev uses http://localhost:5173 (see appsettings.Development.json).
# Cors__AllowedOrigins__0=https://your-frontend.example.com

# External card-data provider (pokemontcg.io, CLAUDE.md §8). The API key is OPTIONAL:
# the provider works without one at a lower rate limit. It is a SECRET — never commit a
# real value; prefer user-secrets locally:
#   dotnet user-secrets set "CardApi:Key" "<your-pokemontcg-io-key>"
# CardApi__Key=your-pokemontcg-io-api-key
# Non-secret defaults (BaseUrl/CacheMinutes/TimeoutSeconds/MaxPageSize) live in
# appsettings.json; override per environment as needed.

# Catalog placeholder image (#9). Absolute URL to the fallback card image served from
# the API's wwwroot, substituted when a catalog card has no provider image. It differs
# per environment (a separate frontend origin consumes it), so it must be set per
# deployment. Dev uses https://localhost:7039/... (appsettings.Development.json); the
# base appsettings.json is empty so startup fails fast until this is configured.
# Catalog__PlaceholderImageUrl=https://your-api.example.com/assets/card-placeholder.svg
